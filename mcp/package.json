{
  "name": "alienpass-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Local Linux MCP + CLI: AlienPass v2 compose vault, keyring passwords, browser sign-in for Cursor subagents",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "alienpass-mcp": "./src/server.js",
    "alienpass-cli": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "cli": "node src/cli.js",
    "doctor": "node src/cli.js doctor",
    "test": "npm run test:engine && npm run test:signin",
    "test:engine": "node src/selftest.js",
    "test:signin": "node src/integration-signin.js",
    "install:local": "bash scripts/install.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "playwright-core": "^1.52.0",
    "zod": "^3.24.1"
  }
}
